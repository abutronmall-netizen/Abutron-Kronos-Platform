ABUTRON_ENV=production
ABUTRON_API_HOST=0.0.0.0
ABUTRON_API_PORT=8080
ABUTRON_ADMIN_BIND=127.0.0.1
ABUTRON_ADMIN_PORT=3000
ABUTRON_POSTGRES_DB=abutron
ABUTRON_POSTGRES_USER=abutron
ABUTRON_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
ABUTRON_DATABASE_URL=postgresql+asyncpg://abutron:REPLACE_WITH_RANDOM_DB_PASSWORD@postgres:5432/abutron
ABUTRON_REDIS_URL=redis://redis:6379/0
ABUTRON_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ABUTRON_JWT_ISSUER=abutron-platform
ABUTRON_ACCESS_TOKEN_MINUTES=30
ABUTRON_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_SERVICE_TOKEN
ABUTRON_KRONOS_ENGINE_URL=http://host.docker.internal:8765
ABUTRON_KRONOS_ENGINE_TOKEN=REPLACE_WITH_LONG_RANDOM_ENGINE_TOKEN
ABUTRON_KRONOS_PUSH_ENABLED=false
ABUTRON_PUSH_GATEWAY_ENABLED=false
ABUTRON_PUSH_GATEWAY_URL=
ABUTRON_PUSH_GATEWAY_TOKEN=
ABUTRON_BILLING_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_BILLING_WEBHOOK_SECRET
ABUTRON_AUTO_CREATE_SCHEMA=false
ABUTRON_CORS_ORIGINS=http://localhost:3000
ABUTRON_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ABUTRON_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD
ABUTRON_BOOTSTRAP_ADMIN_NAME=Abutron Administrator
