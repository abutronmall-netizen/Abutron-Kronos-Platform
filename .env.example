ABUTRON_ENV=development
ABUTRON_API_HOST=0.0.0.0
ABUTRON_API_PORT=8080
ABUTRON_DATABASE_URL=postgresql+asyncpg://abutron:change-me@postgres:5432/abutron
ABUTRON_REDIS_URL=redis://redis:6379/0
ABUTRON_JWT_SECRET=replace-with-at-least-32-random-characters
ABUTRON_JWT_ISSUER=abutron-platform
ABUTRON_ACCESS_TOKEN_MINUTES=30
ABUTRON_SERVICE_TOKEN=replace-with-long-random-service-token
ABUTRON_KRONOS_ENGINE_URL=http://host.docker.internal:8090
ABUTRON_KRONOS_ENGINE_TOKEN=replace-with-engine-token
ABUTRON_KRONOS_PUSH_ENABLED=false
ABUTRON_PUSH_GATEWAY_ENABLED=false
ABUTRON_PUSH_GATEWAY_URL=
ABUTRON_PUSH_GATEWAY_TOKEN=replace-with-push-gateway-token
ABUTRON_AUTO_CREATE_SCHEMA=true
ABUTRON_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ABUTRON_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ABUTRON_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ABUTRON_BOOTSTRAP_ADMIN_NAME=Abutron Administrator
